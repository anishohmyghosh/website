---
import { u } from '../../lib/url';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PostGrid from '../../components/PostGrid.astro';
import { getPosts, tagHref, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.slug }, props: { post, newer: posts[i - 1], older: posts[i + 1], all: posts } }));
}
const { post, newer, older, all } = Astro.props;
const { Content } = await post.render();
const { title, date, tags, cover, description } = post.data;
const related = all
  .filter((p) => p.slug !== post.slug && p.data.tags.some((t) => tags.includes(t)))
  .slice(0, 3);
---
<Base title={title} description={description} image={cover?.src}>
  <article class="post">
    <header class="wrap narrow head">
      <div class="meta">
        <a href={u("/projects")} class="back">← Projects</a>
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </div>
      <div class:list={['title-row', { 'has-icon': cover }]}>
        {cover && (
          <button type="button" class="icon" aria-label="View cover image" data-full={cover.src}>
            <Image src={cover} alt="" widths={[160, 320]} sizes="120px" loading="eager" />
          </button>
        )}
        <div>
          <h1>{title}</h1>
          <div class="tags">{tags.map((t) => <a class="tag" href={tagHref(t)}>{t}</a>)}</div>
        </div>
      </div>
    </header>
    <div class="wrap narrow prose">
      <Content />
    </div>
    <nav class="wrap narrow pager" aria-label="More posts">
      {older ? <a href={u(`/post/${older.slug}`)}><span>← Older</span>{older.data.title}</a> : <span />}
      {newer ? <a class="r" href={u(`/post/${newer.slug}`)}><span>Newer →</span>{newer.data.title}</a> : <span />}
    </nav>
  </article>
  {related.length > 0 && (
    <section class="wrap section">
      <div class="section-head"><h2>More like this</h2></div>
      <PostGrid posts={related} />
    </section>
  )}
</Base>

<!-- Click a post image to see it bigger -->
<dialog class="zoom"><img alt="" /></dialog>
<script is:inline>
  const dlg = document.querySelector('dialog.zoom');
  document.querySelectorAll('.prose img').forEach((img) => {
    if (img.closest('a')) return;
    img.style.cursor = 'zoom-in';
    img.addEventListener('click', () => { dlg.querySelector('img').src = img.currentSrc || img.src; dlg.showModal(); });
  });
  document.querySelector('.title-row .icon')?.addEventListener('click', (e) => {
    dlg.querySelector('img').src = e.currentTarget.dataset.full; dlg.showModal();
  });
  dlg?.addEventListener('click', () => dlg.close());
</script>

<style>
  .narrow { max-width: 760px; }
  .head { padding-top: clamp(2rem, 6vw, 3.5rem); }
  .meta { display: flex; gap: 1rem; align-items: center; color: var(--muted); font-size: .9rem; margin-bottom: 1rem; }
  .back { text-decoration: none; }
  .tags { display: flex; gap: .4rem; flex-wrap: wrap; }
  .title-row { display: flex; align-items: center; gap: 1.25rem; }
  .title-row h1 { margin-bottom: .5rem; }
  .icon { flex: none; width: 120px; height: 120px; padding: 0; border: 1px solid var(--line); border-radius: 22px; overflow: hidden; background: var(--line); cursor: zoom-in; box-shadow: var(--shadow); transition: transform .2s ease; }
  .icon:hover { transform: rotate(-2deg) scale(1.03); }
  .icon :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 560px) { .title-row { align-items: flex-start; gap: .9rem; } .icon { width: 76px; height: 76px; border-radius: 16px; } }
  .prose { margin-top: 2rem; font-size: 1.1rem; }
  .prose :global(p) { margin: 0 0 1.2rem; }
  /* Post photos are small thumbnails; click one to see it full size. */
  .prose :global(img) { width: 240px; max-width: 100%; height: auto; max-height: 240px; object-fit: cover; border-radius: 12px; margin: 1.5rem auto .5rem; border: 1px solid var(--line); transition: transform .2s ease, box-shadow .2s ease; }
  .prose :global(img:hover) { transform: translateY(-2px); box-shadow: var(--shadow); }
  .prose :global(p:has(> img + img)) { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: .6rem; }
  .prose :global(p:has(> img + img) img) { margin: 0; width: 100%; max-height: none; aspect-ratio: 1; }
  .prose :global(.caption) { text-align: center; color: var(--muted); font-size: .9rem; font-style: italic; margin-top: 0; }
  .prose :global(p:has(> .button)) { display: flex; flex-wrap: wrap; gap: .6rem; justify-content: center; margin: 1.75rem 0; }
  .prose :global(a:not(.button)) { color: var(--accent); }
  .prose :global(h2), .prose :global(h3) { margin-top: 2.5rem; }
  .prose :global(blockquote) { margin: 1.5rem 0; padding: .25rem 1.25rem; border-left: 3px solid var(--clay); color: var(--muted); font-style: italic; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; gap: .2rem; text-decoration: none; color: var(--ink); font-family: var(--serif); font-size: 1.05rem; }
  .pager a span { font-family: var(--sans); font-size: .8rem; color: var(--muted); }
  .pager .r { text-align: right; }
  .zoom { padding: 0; border: 0; background: transparent; max-width: 95vw; max-height: 95vh; }
  .zoom::backdrop { background: rgba(20, 20, 15, .85); }
  .zoom img { max-width: 95vw; max-height: 92vh; border-radius: 10px; cursor: zoom-out; }
</style>
