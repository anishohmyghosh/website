---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import SocialIcons from '../components/SocialIcons.astro';
import PdfCard from '../components/PdfCard.astro';
import about from '../data/about.json';
import press from '../data/press.json';
import site from '../data/site.json';
---
<Base title="About" description="About Anish Ghosh: music producer, sound designer, and engineer. Education, press, and contact.">
  <section class="wrap section intro">
    <div>
      <p class="eyebrow">About me</p>
      <h1>Hey, I'm Anish.</h1>
      <p class="big">{about.intro}</p>
      <div class="cta">
        <a class="btn ghost" href="#contact">Get in touch</a>
      </div>
      {site.resumeUrl && <div class="resume"><PdfCard href={site.resumeUrl} title="Anish Ghosh: Resume" /></div>}
    </div>
  </section>

  <section class="wrap section">
    <h2>Education</h2>
    <ol class="timeline">
      {about.education.map((e) => (
        <li>
          <span class="years">{e.years}</span>
          <div>
            <h3>{e.degree}</h3>
            <p class="school">{e.school}</p>
            <p>{e.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>


  <section class="wrap section">
    <h2>Activities &amp; achievements</h2>
    <p class="lead">{about.highlightsIntro}</p>
    <div class="hl-carousel" role="region" aria-roledescription="carousel" aria-label="Activities and achievements" tabindex="0">
      <button type="button" class="hl-nav prev" aria-label="Previous">←</button>
      <div class="hl-stage">
        {about.highlights.map((g, gi) => (
          <article class={`hl hl-${gi}`} data-i={gi} aria-hidden={gi === 0 ? undefined : 'true'} data-state={gi === 0 ? 'active' : 'hidden'}>
            <h3><span class="hl-count">{g.items.length}</span>{g.title}</h3>
            <ul>
              {g.items.map((it) => {
                const ext = it.href?.startsWith('http');
                const inner = (
                  <>
                    <span class="hl-label">{it.label}{it.href && <span class="hl-go" aria-hidden="true">{ext ? '↗' : '→'}</span>}</span>
                    <span class="hl-year">{it.year}</span>
                  </>
                );
                return (
                  <li>
                    {it.href
                      ? <a class="hl-item" href={u(it.href)} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>{inner}</a>
                      : <div class="hl-item">{inner}</div>}
                  </li>
                );
              })}
            </ul>
          </article>
        ))}
      </div>
      <button type="button" class="hl-nav next" aria-label="Next">→</button>
      <div class="hl-dots">
        {about.highlights.map((g, gi) => <button type="button" class:list={['hl-dot', { on: gi === 0 }]} data-i={gi} aria-label={`Show ${g.title}`}></button>)}
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2>Recent press</h2>
    <p class="lead">{about.pressIntro}</p>
    <div class="press">
      {press.map((p) => (
        <a class="pcard" href={p.url} target="_blank" rel="noopener">
          <div class="pimg"><img src={u(p.image)} alt="" loading="lazy" /></div>
          <div class="ptxt">
            <span class="outlet">{p.outlet} · {p.year}</span>
            <span class="ptitle">{p.title}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section" id="contact">
    <div class="contact">
      <div>
        <p class="eyebrow">Contact</p>
        <h2>Let's make something.</h2>
        <p class="lead">Production, mixing, sound design, research collabs, or just to say hi. Reach out on any of these.</p>
        {site.contactEmail && <p><a class="btn" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p>}
      </div>
      <SocialIcons />
    </div>
  </section>
</Base>

<script is:inline>
  document.querySelectorAll('.hl-carousel').forEach((root) => {
    const cards = [...root.querySelectorAll('.hl')];
    const dots = [...root.querySelectorAll('.hl-dot')];
    const n = cards.length;
    let cur = 0;
    const show = (next, dir) => {
      next = ((next % n) + n) % n; // wrap around forever
      if (next === cur) return;
      const out = cards[cur], inn = cards[next];
      out.dataset.state = dir > 0 ? 'out-left' : 'out-right';
      out.setAttribute('aria-hidden', 'true');
      inn.dataset.state = dir > 0 ? 'from-right' : 'from-left';
      inn.removeAttribute('aria-hidden');
      inn.offsetWidth; // restart transition
      inn.dataset.state = 'active';
      dots.forEach((d, i) => d.classList.toggle('on', i === next));
      cur = next;
    };
    root.querySelector('.prev').addEventListener('click', () => show(cur - 1, -1));
    root.querySelector('.next').addEventListener('click', () => show(cur + 1, 1));
    dots.forEach((d) => d.addEventListener('click', () => { const i = +d.dataset.i; show(i, i > cur ? 1 : -1); }));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(cur - 1, -1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(cur + 1, 1); }
    });
    let x0 = null;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) dx < 0 ? show(cur + 1, 1) : show(cur - 1, -1);
    });
  });
</script>
<style>
  .big { font-size: clamp(1.1rem, 2vw, 1.3rem); max-width: 48rem; }
  .resume { max-width: 560px; }
  .cta { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.5rem; }
  .timeline { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0; }
  .timeline li { display: grid; gap: .5rem 2rem; padding: 1.5rem 0; border-top: 1px solid var(--line); }
  @media (min-width: 720px) { .timeline li { grid-template-columns: 160px 1fr; } }
  .years { font-family: var(--serif); font-size: 1.3rem; color: var(--clay); }
  .timeline h3 { margin: 0; font-size: 1.35rem; }
  .school { margin: .1rem 0 .5rem; color: var(--accent); font-weight: 500; }
  .timeline p:last-child { margin: 0; color: var(--muted); }
  /* One card at a time; arrows loop around forever. All cards share one grid cell so the box is as tall as the tallest. */
  .hl-carousel { position: relative; display: grid; grid-template-columns: 1fr minmax(0, 760px) 1fr; align-items: center; gap: 1rem; margin-top: 1.5rem; outline: none; }
  .hl-nav.prev { justify-self: end; }
  .hl-nav.next { justify-self: start; }
  .hl-stage { display: grid; overflow: hidden; padding: .5rem .25rem 1rem; width: 100%; }
  .hl-stage > .hl { grid-area: 1 / 1; transition: transform .45s cubic-bezier(.2,.7,.2,1), opacity .45s ease; }
  .hl[data-state="hidden"] { opacity: 0; visibility: hidden; }
  .hl[data-state="active"] { transform: none; opacity: 1; visibility: visible; }
  .hl[data-state="from-right"] { transform: translateX(60px); opacity: 0; transition: none; }
  .hl[data-state="from-left"] { transform: translateX(-60px); opacity: 0; transition: none; }
  .hl[data-state="out-left"] { transform: translateX(-60px); opacity: 0; visibility: hidden; transition: transform .45s ease, opacity .3s ease, visibility 0s .45s; }
  .hl[data-state="out-right"] { transform: translateX(60px); opacity: 0; visibility: hidden; transition: transform .45s ease, opacity .3s ease, visibility 0s .45s; }
  .hl-nav { width: 3rem; height: 3rem; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font-size: 1.2rem; cursor: pointer; box-shadow: var(--shadow); transition: all .2s ease; }
  .hl-nav:hover { background: var(--accent); color: var(--on-accent); border-color: var(--accent); transform: scale(1.06); }
  .hl-dots { grid-column: 1 / -1; display: flex; justify-content: center; gap: .5rem; }
  .hl-dot { width: .6rem; height: .6rem; padding: 0; border-radius: 999px; border: 0; background: var(--line); cursor: pointer; transition: all .25s ease; }
  .hl-dot.on { width: 1.6rem; background: var(--accent); }
  @media (max-width: 640px) {
    .hl-carousel { grid-template-columns: 1fr 1fr; }
    .hl-stage { grid-column: 1 / -1; grid-row: 1; }
    .hl-nav.prev { grid-row: 2; justify-self: end; }
    .hl-nav.next { grid-row: 2; justify-self: start; }
    .hl-dots { grid-row: 3; }
  }
  @media (prefers-reduced-motion: reduce) { .hl-stage > .hl { transition: none !important; } }
  .hl { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem 1.5rem .8rem; box-shadow: 0 8px 24px -18px rgba(60,50,30,.35); border-top: 4px solid var(--accent); }
  .hl-1 { border-top-color: var(--clay); }
  .hl-2 { border-top-color: #8a7a52; }
  .hl h3 { display: flex; align-items: center; gap: .6rem; margin: 0 0 .8rem; font-size: 1.3rem; line-height: 1.25; }
  .hl-count { flex: none; display: grid; place-items: center; width: 1.9rem; height: 1.9rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-family: var(--sans); font-size: .85rem; font-weight: 600; }
  .hl ul { list-style: none; padding: 0; margin: 0; }
  .hl li + li { border-top: 1px dashed var(--line); }
  .hl-item { display: flex; justify-content: space-between; align-items: baseline; gap: 1.2rem; padding: .7rem .5rem; color: var(--ink); text-decoration: none; font-size: .95rem; line-height: 1.4; border-radius: 8px; }
  a.hl-item { transition: background .2s ease; }
  a.hl-item:hover { background: var(--accent-soft); }
  a.hl-item:hover .hl-go { transform: translateX(3px); }
  .hl-go { display: inline-block; margin-left: .35rem; color: var(--accent); transition: transform .2s ease; }
  .hl-year { flex: none; font-size: .78rem; font-weight: 600; color: var(--clay); background: color-mix(in srgb, var(--clay) 12%, transparent); padding: .12rem .5rem; border-radius: 999px; white-space: nowrap; }
  .press { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); margin-top: 1.5rem; }
  .pcard { display: flex; flex-direction: column; border-radius: var(--radius); overflow: hidden; background: var(--surface); border: 1px solid var(--line); text-decoration: none; color: var(--ink); transition: all .25s ease; }
  .pcard:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--accent); }
  .pimg { aspect-ratio: 16 / 10; overflow: hidden; background: var(--line); }
  .pimg img { width: 100%; height: 100%; object-fit: cover; }
  .ptxt { padding: 1rem 1.1rem 1.2rem; display: flex; flex-direction: column; gap: .3rem; }
  .outlet { font-size: .8rem; color: var(--clay); font-weight: 600; text-transform: uppercase; letter-spacing: .08em; }
  .ptitle { font-family: var(--serif); font-size: 1.15rem; line-height: 1.3; }
  .contact { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem; padding: clamp(1.5rem, 4vw, 3rem); border-radius: 28px; background: var(--accent-soft); }
  .contact h2 { margin-bottom: .5rem; }
</style>
