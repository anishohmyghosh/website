---
import * as icons from 'simple-icons';
import site from '../data/site.json';
const map: Record<string, any> = {
  linkedin: icons.siLinkedin, github: icons.siGithub, spotify: icons.siSpotify, applemusic: icons.siApplemusic,
  youtube: icons.siYoutube, instagram: icons.siInstagram, facebook: icons.siFacebook, soundcloud: icons.siSoundcloud,
};
const links = site.socials.filter((s) => s.url);
---
<ul class="socials">
  {links.map((s) => (
    <li>
      <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={map[s.icon]?.path} fill="currentColor" /></svg>
      </a>
    </li>
  ))}
</ul>
<style>
  .socials { display: flex; flex-wrap: wrap; gap: .5rem; list-style: none; padding: 0; margin: 0; }
  .socials a {
    display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 999px;
    color: var(--ink); background: var(--surface); border: 1px solid var(--line);
    transition: transform .2s ease, background .2s ease, color .2s ease;
  }
  .socials a:hover { transform: translateY(-2px); background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
</style>
