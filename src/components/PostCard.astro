---
import { Image } from 'astro:assets';
import { tagHref, formatDate, type Post } from '../lib/posts';
interface Props { post: Post; size?: 'md' | 'lg'; eager?: boolean }
const { post, size = 'md', eager = false } = Astro.props;
const { title, date, tags, cover, description } = post.data;
const hue = [...post.slug].reduce((a, c) => a + c.charCodeAt(0), 0) % 360;
---
<article class={`card ${size}`}>
  <a class="thumb" href={`/post/${post.slug}`} tabindex="-1" aria-hidden="true">
    {cover ? (
      <Image src={cover} alt="" widths={[400, 700, 1000]} sizes="(max-width: 700px) 100vw, 400px" loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <div class="placeholder" style={`--h:${hue}`}><span>{title}</span></div>
    )}
  </a>
  <div class="body">
    <div class="meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {tags.map((t) => <a class="tag" href={tagHref(t)}>{t}</a>)}
    </div>
    <h3><a href={`/post/${post.slug}`}>{title}</a></h3>
    {size === 'lg' && description && <p class="desc">{description}</p>}
  </div>
</article>
<style>
  .card { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: transform .25s ease, box-shadow .25s ease; }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .thumb { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--line); }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  .card:hover .thumb :global(img) { transform: scale(1.04); }
  .placeholder { width: 100%; height: 100%; display: grid; place-items: center; padding: 1rem; text-align: center;
    background: linear-gradient(135deg, hsl(var(--h) 25% 72%), hsl(calc(var(--h) + 40) 30% 58%)); color: #fff; font-family: var(--serif); font-size: 1.3rem; }
  .body { padding: 1rem 1.1rem 1.2rem; display: flex; flex-direction: column; gap: .5rem; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .5rem; font-size: .8rem; color: var(--muted); }
  h3 { margin: 0; font-family: var(--serif); font-weight: 500; font-size: 1.2rem; line-height: 1.25; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { color: var(--accent); }
  .desc { margin: 0; color: var(--muted); font-size: .95rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
