---
import { u } from '../lib/url';
// Each item: { src, alt, srcDark?, bg?, fit? }
//   srcDark: alternate image shown in dark mode (e.g. a logo on a black background)
//   bg:      tile background color (handy for white/transparent logos)
//   fit:     "contain" shows the whole image instead of cropping it to a square
type Item = { src: string; alt: string; srcDark?: string; bg?: string; fit?: string };
interface Props { items: Item[]; limit?: number }
const { items, limit } = Astro.props;
const shown = limit ? items.slice(0, limit) : items;
---
<div class="gallery">
  {shown.map((g) => (
    <button type="button" class:list={['g', { contain: g.fit === 'contain', themed: g.srcDark }]} style={g.bg ? `background:${g.bg}` : undefined}
      data-src={u(g.src)} data-src-dark={g.srcDark ? u(g.srcDark) : undefined} aria-label={`View ${g.alt}`}>
      <img class="light-img" src={u(g.src)} alt={g.alt} loading="lazy" />
      {g.srcDark && <img class="dark-img" src={u(g.srcDark)} alt="" loading="lazy" />}
    </button>
  ))}
</div>
<dialog class="lightbox"><img alt="" /></dialog>
<script is:inline>
  const isDark = () => {
    const t = document.documentElement.dataset.theme;
    return t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  };
  document.querySelectorAll('.gallery .g').forEach((b) => b.addEventListener('click', () => {
    const d = b.closest('.gallery').nextElementSibling;
    d.querySelector('img').src = (isDark() && b.dataset.srcDark) || b.dataset.src; d.showModal();
  }));
  document.querySelectorAll('dialog.lightbox').forEach((d) => d.addEventListener('click', () => d.close()));
</script>
<style>
  .gallery { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); }
  .g { position: relative; padding: 0; border: 0; border-radius: 14px; overflow: hidden; aspect-ratio: 1; background: var(--line); cursor: zoom-in; }
  .g img { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .g.contain img { object-fit: contain; }
  .g:hover img { transform: scale(1.05); }
  .g .dark-img { position: absolute; inset: 0; display: none; }
  :global(:root[data-theme="dark"]) .g.themed .dark-img { display: block; }
  :global(:root[data-theme="dark"]) .g.themed .light-img { visibility: hidden; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .g.themed .dark-img { display: block; }
    :global(:root:not([data-theme="light"])) .g.themed .light-img { visibility: hidden; }
  }
  .lightbox { padding: 0; border: 0; background: transparent; max-width: 95vw; max-height: 95vh; }
  .lightbox::backdrop { background: rgba(20, 20, 15, .85); }
  .lightbox img { max-width: 95vw; max-height: 92vh; border-radius: 10px; cursor: zoom-out; }
</style>
